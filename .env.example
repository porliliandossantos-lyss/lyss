# Copie este arquivo para .env e preencha os valores reais.
# .env nunca deve ser commitado (ja esta no .gitignore).

# Chave gratuita da Groq (console.groq.com/keys) — usada para roteiro e respostas de comentarios.
GROQ_API_KEY=

# Fallback quando o Groq estoura limite (por minuto ou por dia). Pegue em
# aistudio.google.com/apikey — pode reaproveitar a mesma chave da Adira.
GEMINI_API_KEY=

# Porta do painel local
PORT=3300

# Idioma do canal (usado nos prompts de geracao)
CONTENT_LANGUAGE=en

# Nicho de fallback, usado só se a Adira estiver inalcançável (ver
# ADIRA_BASE_URL abaixo) — o nicho real do dia a dia é a diretiva "niche" da
# Adira, não este valor. Mantenha atualizado mesmo assim: se a Adira cair,
# é isso que a Lyss usa até ela voltar.
DEFAULT_NICHE=curiosities

# Meta ativa combinada na aba Conversa
GOAL_FOLLOWERS_TARGET=1000
GOAL_DEADLINE=2026-09-30

# Perfil dedicado do Chrome onde o TikTok já está logado manualmente (login feito
# por você, nunca pela Lyss). Descubra o caminho abrindo chrome://version nesse
# perfil ("Caminho do perfil"). Feche o Chrome inteiro antes de rodar scripts que usem isso.
TIKTOK_CHROME_PROFILE=

# Content Posting API oficial (em migração — ver HANDOFF.md "Migração pra API
# oficial do TikTok"). Client Key/Secret vêm do app criado em
# developers.tiktok.com. TIKTOK_REDIRECT_URI precisa ser https, estático (sem
# query string) e cadastrado no produto Login Kit do app antes de usar.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=

# Só pra popular o campo "accounts" do relatório pra Adira (não afeta login).
TIKTOK_ACCOUNT_HANDLE=
TIKTOK_ACCOUNT_EMAIL=

# --- Buffer (ponte manual-assistida enquanto a API oficial do TikTok está em
# revisão) --- Plano gratuito não tem API própria, então isso reaproveita um
# perfil de Chrome dedicado (login manual, mesma regra do TikTok) pra subir
# rascunhos que você aprova depois pelo app do Buffer no celular. Ativado pela
# diretiva "buffer_draft" da Adira, não por esta variável sozinha.
BUFFER_CHROME_PROFILE=

# Canal de comunicação com a Adira (a IA orquestradora/CEO). Vazio = os
# relatórios ficam só em output/adira-outbox.jsonl, sem enviar pra nenhum lugar.
ADIRA_WEBHOOK_URL=http://localhost:3400/api/report
# Só necessário se a Adira exigir autenticação (REPORT_INGEST_KEY configurada
# do lado dela). Vazio = manda sem header de autenticação.
ADIRA_INGEST_KEY=
# Base URL da Adira (sem /api) — usada pra consultar diretivas (nicho, pausa,
# instrução livre) antes de cada ciclo. Vazio = Lyss usa só os padrões locais.
ADIRA_BASE_URL=http://localhost:3400

# Agendamento do ciclo completo (npm run schedule). Vazio = desligado.
# Frequência é decisão de estratégia, combinar antes de definir um valor.
RUN_CYCLE_INTERVAL_HOURS=

# --- Stock footage (Pexels Videos API, gratuita, sem cartão) ---
# Crie em pexels.com/api
PEXELS_API_KEY=

# --- YouTube Shorts (API oficial do Google) ---
# Crie em console.cloud.google.com: um projeto, ative "YouTube Data API v3",
# crie uma credencial OAuth 2.0 tipo "App de Desktop".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8787/oauth2callback

# --- Instagram Reels (API oficial da Meta) ---
# Precisa de: conta profissional (Business/Creator) do Instagram vinculada a
# uma Página do Facebook, um app em developers.facebook.com com os produtos
# "Instagram Graph API" e permissões instagram_content_publish +
# instagram_manage_comments aprovadas.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
# Onde os .mp4 da Lyss ficam publicamente acessíveis (o Instagram busca o vídeo
# por URL, não aceita upload direto de arquivo).
INSTAGRAM_VIDEO_PUBLIC_BASE_URL=
